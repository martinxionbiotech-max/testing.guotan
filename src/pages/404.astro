---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, url } from '../data/site-config';
import { SITES } from '../lib/sites';
import { testMethods } from '../data/tests';

const title = 'Page not found';
const description = 'The page you requested could not be found. Browse the charcoal test methodology pages instead.';
---

<BaseLayout
  site={site}
  title={title}
  description={description}
  noindex={true}
>
  <section class="page-title">
    <div class="container">
      <h1>404 — page not found</h1>
      <p class="lede">
        That page does not exist on Charcoal Hub Testing. The links below cover
        everything published here so far.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-secondary" href="/tests/">All test methods</a>
        <a class="btn btn-secondary" href="/reports/">Test reports</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Test methodology</h2>
      <div class="grid grid-3">
        {
          testMethods.map((t) => (
            <a class="card" href={`/tests/${t.slug}/`}>
              <h3>{t.name}</h3>
              <p>Read the methodology →</p>
            </a>
          ))
        }
      </div>
      <p style="margin-top:1.5rem">
        Looking for the main platform?
        <a href={`${SITES.main}/`} target="_blank" rel="noopener">guotan.com</a>
      </p>
    </div>
  </section>
</BaseLayout>
