---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Privacy & Data Policy', path: '/privacy/' },
];
const jsonLd = [
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, Astro.site).href }))),
];
---

<BaseLayout
  site={site}
  title="Privacy & Data Policy"
  description="Charcoal Hub testing sub-site policy: methodology-only content, no fabricated results, and what this site does not collect."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: c.path }))}
>
  <div class="page-title container">
    <h1>Privacy &amp; Data Policy</h1>
    <p class="lede">
      This sub-site explains how charcoal quality is measured. It publishes
      methodology — not results.
    </p>
  </div>

  <section class="section">
    <div class="container prose">
      <p>Last updated: 2026-10-07</p>

      <h2>1. Methodology only</h2>
      <p>
        Test pages describe what each parameter measures and how it is
        generally measured under public standards. They contain no
        supplier-specific results and no numeric values presented as our own
        data. Industry reference points are labelled as class-level context
        compiled from public sources.
      </p>

      <h2>2. Test reports</h2>
      <p>
        The reports database is published only with genuine, attributable
        reports — named laboratory, report number, test date, standard and
        document reference. No synthetic entries, no placeholder results, no
        unattributed figures.
      </p>

      <h2>3. What we do not collect</h2>
      <p>
        No analytics, no tracking cookies, no advertising pixels. The hosting
        platform may keep standard security logs under its own policy.
      </p>

      <h2>4. Inquiries</h2>
      <p>
        This sub-site has no forms. Network-wide terms: main site
        <a href={`${SITES.main}/privacy/`}>privacy policy</a> and
        <a href={`${SITES.main}/terms/`}>terms of use</a>. Contact:
        <a href="mailto:joanna@dinweys.com">joanna@dinweys.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
